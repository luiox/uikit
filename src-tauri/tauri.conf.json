{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "nassistant",
    "version": "0.1.0"
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../ui",
    "distDir": "../ui"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "window": {
        "all": true,
        "create": true,
        "show": true,
        "hide": true,
        "close": true,
        "setFocus": true
      },
      "shell": {
        "all": false,
        "open": true
      },
      "globalShortcut": {
        "all": true
      }
    },
    "bundle": {
      "active": false,
      "identifier": "com.nassistant.app"
    },
    "systemTray": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';"
    },
    "windows": [
      {
        "label": "main",
        "title": "nassistant",
        "width": 1040,
        "height": 700,
        "resizable": true
      }
    ]
  }
}
