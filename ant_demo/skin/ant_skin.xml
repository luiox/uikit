<?xml version="1.0" encoding="utf-8"?>
<Window
    size="460,320"
    caption="0,0,0,32"
    canmove="true"
    canresize="true"
    mininfo="360,240,0,0"
    bkcolor="0xFFF7FAFD"
    bordercolor="0xFFD9E2EC"
    bordersize="1"
    roundcorner="8,8">

    <VerticalLayout inset="20,20,20,20" childpadding="12">
        <Label text="Ant Demo" textcolor="0xFF102A43" font="0" height="32" />
        <Label text="这是恢复后的最小 DuiLib 皮肤示例，避免 xmake run 因缺少 skin 目录失败。" textcolor="0xFF486581" height="36" />

        <HorizontalLayout height="48" childpadding="12">
            <Button name="btn_normal" text="普通按钮" style="style_ant_button" width="120" />
            <Button name="btn_icon" text="强调按钮" style="style_ant_button_primary" width="120" />
        </HorizontalLayout>

        <HorizontalLayout height="36" childpadding="18">
            <Option name="opt_check" text="复选项" group="checkgroup" selected="false" />
            <Option name="opt_radio1" text="模式 A" group="radgroup" selected="true" />
            <Option name="opt_radio2" text="模式 B" group="radgroup" />
        </HorizontalLayout>

        <VerticalLayout inset="16,16,16,16" bkcolor="0xFFFFFFFF" bordercolor="0xFFE4ECF3" bordersize="1" roundcorner="8,8" childpadding="8">
            <Label text="资源说明" textcolor="0xFF243B53" />
            <Label text="- ant_demo 现在自带最小 skin/ant_skin.xml" textcolor="0xFF486581" />
            <Label text="- 构建后会复制 skin 目录到输出目录" textcolor="0xFF486581" />
            <Label text="- 不再依赖缺失的 PNG 图集才能启动" textcolor="0xFF486581" />
        </VerticalLayout>
    </VerticalLayout>

    <style name="style_ant_button" value="bordercolor=0xFF91D5FF bordersize=1 bkcolor=0xFFFFFFFF hotbkcolor=0xFFE6F7FF pushedbkcolor=0xFFBAE7FF textcolor=0xFF102A43 padding=12,0,12,0 roundcorner=6,6" />
    <style name="style_ant_button_primary" value="bordercolor=0xFF1677FF bordersize=1 bkcolor=0xFF1677FF hotbkcolor=0xFF4096FF pushedbkcolor=0xFF0958D9 textcolor=0xFFFFFFFF padding=12,0,12,0 roundcorner=6,6" />
</Window>