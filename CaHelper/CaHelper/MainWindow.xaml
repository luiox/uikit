<Window x:Class="CaHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CaHelper"
        mc:Ignorable="d"
        Title="CaHelper - CodeFileGen v0.1 by Canrad" Height="326" Width="544">
    <Grid>
        <Button x:Name="file_gen_btn" Content="生成文件" HorizontalAlignment="Left" Margin="232,183,0,0" VerticalAlignment="Top" RenderTransformOrigin="-2.371,1.288" Click="Button_Click"/>
        <Label Content="头文件名：" HorizontalAlignment="Left" Margin="72,72,0,0" VerticalAlignment="Top"/>
        <Label Content="源文件名：" HorizontalAlignment="Left" Margin="72,118,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.007,-0.054"/>
        <CheckBox x:Name="enable_same_check_box" Content="头文件和源文件名字一样" HorizontalAlignment="Left" Margin="31,182,0,0" VerticalAlignment="Top" IsChecked="True"/>
        <TextBox x:Name="header_file_name_edit" HorizontalAlignment="Left" Margin="164,76,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TextChanged="header_file_name_edit_TextChanged"/>
        <TextBox x:Name="source_file_name_edit" HorizontalAlignment="Left" Margin="164,122,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <RadioButton x:Name="use_angle_brackets_btn" Content="使用&lt;&gt;" HorizontalAlignment="Left" Margin="31,227,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="use_double_quotation_marks_btn" Content="使用&quot;&quot;" HorizontalAlignment="Left" Margin="107,227,0,0" VerticalAlignment="Top" IsChecked="True"/>

    </Grid>
</Window>
